BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_NAME=Inkverelle Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-12-chars-minimum
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Set this to your provider's pooled PostgreSQL connection string for Vercel Functions.
DATABASE_URL_POOLED=postgresql://user:password@pooler-host/database?sslmode=require
# Set a unique random value in Vercel; this authenticates the daily retention job.
CRON_SECRET=replace-with-a-unique-random-cron-secret
# Email is sent only when Resend is configured with a key and verified sender domain.
RESEND_API_KEY=re_replace-with-a-sending-only-key
EMAIL_FROM=Inkverelle <hello@your-verified-domain.example>
ADMIN_NOTIFICATION_EMAIL=you@example.com
PUBLIC_SITE_URL=https://your-production-domain.example
